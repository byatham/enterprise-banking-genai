# Application
APP_ENV=local

# PostgreSQL
POSTGRES_DB=banking_genai
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=local_dev_password

DB_URL=jdbc:postgresql://localhost:5432/banking_genai
DB_USERNAME=banking_user
DB_PASSWORD=local_dev_password

DATABASE_URL=postgresql+psycopg://banking_user:local_dev_password@localhost:5432/banking_genai

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# AWS
AWS_REGION=ap-south-1

# Bedrock - configure in a later milestone
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_EMBEDDING_MODEL_ID=